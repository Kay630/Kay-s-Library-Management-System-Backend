# Copy this file to .env and fill it in. Never share .env or put it on GitHub.

# The code people must type to create an ADMIN account.
ADMIN_CODE=
# Long random string (32+ characters). Signs login tokens.
JWT_SECRET=

# --- Online database and file storage (Supabase) ---
# Supabase > Connect > Session pooler > URI (put your database password in)
DATABASE_URL=
# Supabase > Project Settings > Data API > Project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=
# Supabase > Project Settings > API Keys > Secret key (starts with sb_secret_). Keep it private.
SUPABASE_SECRET_KEY=

PORT=3000
# Where your website lives once it is online (comma separated). Leave empty while testing.
FRONTEND_URL=
# Set to 1 when the backend runs behind a host like Render or Railway.
TRUST_PROXY=0
